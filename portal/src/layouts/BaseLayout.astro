---
import { SITE } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdSlot from "../components/AdSlot.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site || "https://lombakurasi.id").toString();
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const hasLiveMobileAd = Boolean(SITE.ads.adsenseClient && SITE.ads.slots.mobileAnchor);
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="id_ID" />

    {
      SITE.ads.adsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.ads.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }

    {
      ldList.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <Header activePath={canonicalPath} />
    <main class="container">
      <slot />
    </main>
    <Footer />

    {
      (hasLiveMobileAd || SITE.ads.showPlaceholders) && (
        <div class="mobile-anchor-ad" id="mobileAnchorBar">
          <button
            class="mobile-anchor-close"
            type="button"
            onclick="document.getElementById('mobileAnchorBar').style.display='none'"
            aria-label="Tutup Iklan"
          >
            Tutup ×
          </button>
          <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;">Iklan</div>
          {hasLiveMobileAd ? (
            <ins
              class="adsbygoogle"
              style="display:inline-block;width:320px;height:50px"
              data-ad-client={SITE.ads.adsenseClient}
              data-ad-slot={SITE.ads.slots.mobileAnchor}
            />
          ) : (
            <div style="font-size:11.5px;color:#94a3b8;height:40px;display:flex;align-items:center;">
              Mobile Sticky Anchor Ad (320×50)
            </div>
          )}
        </div>
      )
    }

    <script is:inline>
      (function () {
        const KEY = "lombakurasi_saved_slugs";
        function getSaved() {
          try {
            return JSON.parse(localStorage.getItem(KEY) || "[]");
          } catch {
            return [];
          }
        }
        function setSaved(arr) {
          localStorage.setItem(KEY, JSON.stringify(arr));
          syncUI();
        }
        function syncUI() {
          const saved = new Set(getSaved());
          const pill = document.getElementById("navSavedCount");
          if (pill) pill.textContent = String(saved.size);
          document.querySelectorAll("[data-save-slug]").forEach((btn) => {
            const slug = btn.getAttribute("data-save-slug");
            if (saved.has(slug)) {
              btn.classList.add("saved");
              btn.textContent = "Tersimpan";
            } else {
              btn.classList.remove("saved");
              btn.textContent = "Simpan";
            }
          });
        }
        window.toggleSaveLomba = function (slug) {
          const list = getSaved();
          const idx = list.indexOf(slug);
          if (idx >= 0) list.splice(idx, 1);
          else list.push(slug);
          setSaved(list);
          window.dispatchEvent(new CustomEvent("lombakurasi:saved-changed"));
        };
        window.getSavedLombaSlugs = getSaved;
        window.syncSaveButtons = syncUI;
        document.addEventListener("DOMContentLoaded", syncUI);
      })();
    </script>
  </body>
</html>
