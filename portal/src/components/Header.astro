---
import { SITE } from "../config/site";

export interface Props {
  activePath?: string;
}

const { activePath = "/" } = Astro.props;
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </span>
      <span style="display:flex;flex-direction:column;line-height:1.1;">
        <span>{SITE.name}</span>
        <span class="mono" style="font-size:10.5px;font-weight:600;color:var(--text-soft);letter-spacing:0.02em;">{SITE.domain}</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="Navigasi Utama">
      <a class={`nav-link ${activePath === "/" ? "active" : ""}`} href="/">Beranda</a>
      <a class={`nav-link ${activePath.startsWith("/kategori/pendaftaran-dibuka") ? "active" : ""}`} href="/kategori/pendaftaran-dibuka/">Pendaftaran Dibuka</a>
      <a class={`nav-link ${activePath.startsWith("/kategori/bintang-4-dan-5") ? "active" : ""}`} href="/kategori/bintang-4-dan-5/">Bintang 4–5</a>
      <a class={`nav-link ${activePath.startsWith("/kategori") && !activePath.startsWith("/kategori/pendaftaran-dibuka") && !activePath.startsWith("/kategori/bintang-4-dan-5") ? "active" : ""}`} href="/kategori/">Kategori</a>
      <a class={`nav-link ${activePath.startsWith("/panduan") ? "active" : ""}`} href="/panduan/">Panduan Kurasi</a>
      <a class={`nav-link ${activePath.startsWith("/tersimpan") ? "active" : ""}`} href="/tersimpan/">
        Tersimpan <span class="saved-pill" id="navSavedCount">0</span>
      </a>
    </nav>
  </div>
</header>
