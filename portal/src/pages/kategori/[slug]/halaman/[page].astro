---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import DirectoryView from "../../../../components/DirectoryView.astro";
import rawLomba from "../../../../data/lomba.json";
import type { OrganizerItem } from "../../../../utils/format";
import { HUBS, type HubDefinition } from "../../../../data/hubs";
import { SITE } from "../../../../config/site";

export function getStaticPaths() {
  const allItems = rawLomba as OrganizerItem[];
  const paths: any[] = [];
  for (const hub of HUBS) {
    const matched = allItems.filter(hub.filterFn);
    const totalPages = Math.ceil(matched.length / SITE.perPage);
    for (let p = 2; p <= totalPages; p++) {
      const start = (p - 1) * SITE.perPage;
      paths.push({
        params: { slug: hub.slug, page: String(p) },
        props: {
          hub,
          matched,
          pageItems: matched.slice(start, start + SITE.perPage),
          currentPage: p,
          totalPages,
        },
      });
    }
  }
  return paths;
}

const { hub, matched, pageItems, currentPage, totalPages } = Astro.props as {
  hub: HubDefinition;
  matched: OrganizerItem[];
  pageItems: OrganizerItem[];
  currentPage: number;
  totalPages: number;
};

const basePath = `/kategori/${hub.slug}/`;
const canonicalPath = `${basePath}halaman/${currentPage}/`;
const prevPath = currentPage <= 2 ? basePath : `${basePath}halaman/${currentPage - 1}/`;
const nextPath = currentPage < totalPages ? `${basePath}halaman/${currentPage + 1}/` : undefined;
---

<BaseLayout
  title={`${hub.title} (Halaman ${currentPage}) — ${SITE.name}`}
  description={hub.metaDescription}
  canonicalPath={canonicalPath}
  noindex={true}
  prevPath={prevPath}
  nextPath={nextPath}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Beranda</a> / <a href="/kategori/">Kategori</a> / <a href={basePath}>{hub.shortTitle}</a> / <span>Halaman {currentPage}</span>
  </nav>

  <section class="hero" style="margin-top:8px;">
    <h1>{hub.title} — Halaman {currentPage}</h1>
    <p>{hub.intro}</p>
  </section>

  <AdSlot type="leaderboard" slotId={SITE.ads.slots.topLeaderboard} />

  <div class="layout-2col">
    <div>
      <DirectoryView
        allItems={matched}
        pageItems={pageItems}
        currentPage={currentPage}
        totalPages={totalPages}
        basePath={basePath}
        hideClusterFilter={["riset-dan-inovasi", "olahraga", "seni-budaya"].includes(hub.slug)}
        hideLevelFilter={["internasional", "nasional"].includes(hub.slug)}
        hideStatusFilter={hub.slug === "pendaftaran-dibuka"}
      />
    </div>

    <aside class="sidebar-sticky">
      <AdSlot type="sidebar-box" slotId={SITE.ads.slots.sidebarBox} />
      <div class="panel">
        <h3 style="font-size:13px;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:6px;">
          Kategori Lainnya
        </h3>
        <ul class="sidebar-list">
          {
            HUBS.filter((h) => h.slug !== hub.slug).map((h) => (
              <li>
                <a href={`/kategori/${h.slug}/`}>{h.shortTitle}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <AdSlot type="sidebar-sticky" slotId={SITE.ads.slots.sidebarSticky} />
    </aside>
  </div>
</BaseLayout>
