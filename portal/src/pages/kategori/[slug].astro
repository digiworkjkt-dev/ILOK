---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import DirectoryView from "../../components/DirectoryView.astro";
import rawLomba from "../../data/lomba.json";
import type { OrganizerItem } from "../../utils/format";
import { HUBS, type HubDefinition } from "../../data/hubs";
import { SITE } from "../../config/site";

export function getStaticPaths() {
  const allItems = rawLomba as OrganizerItem[];
  return HUBS.map((hub) => {
    const matched = allItems.filter(hub.filterFn);
    return {
      params: { slug: hub.slug },
      props: { hub, matched },
    };
  });
}

const { hub, matched } = Astro.props as { hub: HubDefinition; matched: OrganizerItem[] };
const pageItems = matched.slice(0, SITE.perPage);
const totalPages = Math.max(1, Math.ceil(matched.length / SITE.perPage));
const canonicalPath = `/kategori/${hub.slug}/`;
const siteBase = Astro.site || "https://lombakurasi.id";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: new URL("/", siteBase).toString() },
    { "@type": "ListItem", position: 2, name: "Kategori", item: new URL("/kategori/", siteBase).toString() },
    { "@type": "ListItem", position: 3, name: hub.shortTitle, item: new URL(canonicalPath, siteBase).toString() },
  ],
};
---

<BaseLayout
  title={`${hub.title} — ${SITE.name}`}
  description={hub.metaDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Beranda</a> / <a href="/kategori/">Kategori</a> / <span>{hub.shortTitle}</span>
  </nav>

  <section class="hero" style="margin-top:8px;">
    <h1>{hub.title}</h1>
    <p>{hub.intro}</p>
    <div class="hero-badges">
      <span class="hero-badge">{matched.length} Penyelenggara Terkurasi</span>
      <span class="hero-badge">{matched.filter((x) => x.status === "Pendaftaran Dibuka").length} Pendaftaran Dibuka</span>
      <span class="hero-badge">{matched.filter((x) => x.rating >= 4).length} Bintang 4★ &amp; 5★</span>
    </div>
  </section>

  <AdSlot type="leaderboard" slotId={SITE.ads.slots.topLeaderboard} />

  <div class="layout-2col">
    <div>
      <DirectoryView
        allItems={matched}
        pageItems={pageItems}
        currentPage={1}
        totalPages={totalPages}
        basePath={canonicalPath}
        hideClusterFilter={["riset-dan-inovasi", "olahraga", "seni-budaya"].includes(hub.slug)}
        hideLevelFilter={["internasional", "nasional"].includes(hub.slug)}
        hideStatusFilter={hub.slug === "pendaftaran-dibuka"}
      />

      <section class="panel" style="margin-top:16px;">
        <h2 style="font-size:16px;margin-bottom:8px;">Catatan Persiapan: {hub.shortTitle}</h2>
        <ul style="margin:0;padding-left:18px;color:var(--text-muted);">
          {hub.tips.map((t) => <li style="margin-bottom:6px;">{t}</li>)}
        </ul>
      </section>
    </div>

    <aside class="sidebar-sticky">
      <AdSlot type="sidebar-box" slotId={SITE.ads.slots.sidebarBox} />
      <div class="panel">
        <h3 style="font-size:13px;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:6px;">
          Kategori Lainnya
        </h3>
        <ul class="sidebar-list">
          {
            HUBS.filter((h) => h.slug !== hub.slug).map((h) => (
              <li>
                <a href={`/kategori/${h.slug}/`}>{h.shortTitle}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <AdSlot type="sidebar-sticky" slotId={SITE.ads.slots.sidebarSticky} />
    </aside>
  </div>
</BaseLayout>
